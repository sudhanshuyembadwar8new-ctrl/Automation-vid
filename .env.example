# ══════════════════════════════════════════════════════
# 🚀 YOUTUBE AUTOMATION ENGINE — Environment Variables
# ══════════════════════════════════════════════════════
# Copy this file to .env → fill in your keys
# NEVER commit .env to git!

# ── REQUIRED ────────────────────────────────────────
# Gemini API (FREE: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ── OPTIONAL (for YouTube upload) ────────────────────
# YouTube Data API v3 (from Google Cloud Console)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── OPTIONAL (for cross-posting) ────────────────────
# Instagram Graph API
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Twitter/X API v2
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── PATHS (defaults work fine) ──────────────────────
OUTPUT_DIR=./output
TEMP_DIR=./temp

# ── DASHBOARD ───────────────────────────────────────
DASHBOARD_PORT=3000
